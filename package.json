{
  "name": "inbot-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, privacy-first email for AI agents.",
  "keywords": [
    "ai-agents",
    "email",
    "encrypted",
    "mcp",
    "privacy",
    "self-hosted"
  ],
  "homepage": "https://inbot.kerd.dev",
  "bugs": "https://github.com/kerddotdev/inbot/issues",
  "license": "MIT",
  "author": "Dániel Kerekes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerddotdev/inbot.git"
  },
  "bin": {
    "inbot": "dist/apps/cli/src/main.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p apps/worker/tsconfig.build.json && pnpm build:worker",
    "start:server": "node dist/apps/server/src/main.js serve",
    "typecheck": "tsc --noEmit && tsc -p apps/worker/tsconfig.json && tsc -p apps/worker/tsconfig.test.json && pnpm --filter @inbot/web typecheck",
    "web:dev": "pnpm --filter @inbot/web dev",
    "web:build": "pnpm --filter @inbot/web build",
    "docs:dev": "pnpm build && pnpm --filter @inbot/docs dev",
    "docs:build": "pnpm build && pnpm --filter @inbot/docs build",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings apps packages",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "build:worker": "node scripts/build-worker.mjs",
    "start:cli": "node dist/apps/cli/src/main.js",
    "package": "node scripts/package.mjs",
    "test:packaging": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@napi-rs/keyring": "2.1.0",
    "age-encryption": "0.3.1",
    "agentextract": "0.3.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "effect": "4.0.2",
    "postal-mime": "4.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@types/node": "24.13.4",
    "esbuild": "0.28.0",
    "jsdom": "30.1.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.0.2",
      "exceljs@4.4.0>unzipper": "0.12.5"
    }
  }
}
