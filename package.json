{
  "name": "inbot-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings apps packages",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.0",
    "agentextract": "0.3.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "effect": "4.0.2",
    "postal-mime": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@10.24.0"
}
