{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "better-sqlite3-multiple-ciphers": [
        "./node_modules/better-sqlite3-multiple-ciphers/index.d.ts"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2024"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["apps/*/src/**/*.ts", "packages/*/src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "apps/worker"]
}
