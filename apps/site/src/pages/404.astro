---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist." noindex>
  <section class="hero">
    <h1 class="display">This page is not here.</h1>
    <p class="lede">The address may have changed. Start again from one of these.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-quiet" href="/docs">Docs</a>
    </div>
  </section>
</Base>
