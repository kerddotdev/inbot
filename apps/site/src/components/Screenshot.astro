---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  eager?: boolean;
}
const { light, dark, alt, eager = false } = Astro.props;
const widths = [720, 1200, 1680, 2400];
const sizes = "(max-width: 56rem) 100vw, 46rem";

async function sources(image: ImageMetadata) {
  const usable = widths.filter((width) => width <= image.width);
  const [avif, webp] = await Promise.all(
    (["avif", "webp"] as const).map((format) =>
      getImage({ src: image, widths: usable, format, quality: 72 }),
    ),
  );
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute };
}
const [lightSet, darkSet] = await Promise.all([sources(light), sources(dark)]);
const fallback = await getImage({ src: light, width: 1200, format: "webp", quality: 72 });
---

<div class="shot" data-reveal={eager ? undefined : ""}>
  <picture>
    <source media="(prefers-color-scheme: dark)" type="image/avif" srcset={darkSet.avif} sizes={sizes} />
    <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={darkSet.webp} sizes={sizes} />
    <source type="image/avif" srcset={lightSet.avif} sizes={sizes} />
    <source type="image/webp" srcset={lightSet.webp} sizes={sizes} />
    <img
      src={fallback.src}
      alt={alt}
      width={light.width}
      height={light.height}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
    />
  </picture>
</div>

<style>
  .shot {
    overflow: hidden;
    border-radius: 14px;
    box-shadow: var(--shadow);
    background: var(--win);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
