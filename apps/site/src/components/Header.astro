---
import Mark from "./Mark.astro";

interface Props {
  current?: string | undefined;
}
const { current } = Astro.props;
const links = [
  { href: "/features", label: "Features" },
  { href: "/compare", label: "Compare" },
  { href: "/docs", label: "Docs" },
  { href: "https://github.com/kerddotdev/inbot", label: "GitHub" },
];
const start = "/docs/get-started/install";
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Inbot home">
    <Mark />
    Inbot
  </a>
  <nav class="nav" aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} aria-current={current === link.href ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
    <a class="btn btn-primary btn-sm" href={start}>Get started</a>
  </nav>
  <details class="menu">
    <summary aria-label="Menu">
      <svg class="open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M4 8h16M4 16h16"></path>
      </svg>
      <svg class="close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </summary>
    <nav aria-label="Menu">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current === link.href ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
      <a href={start}>Get started</a>
    </nav>
  </details>
</header>
