{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inbot-site",
  "compatibility_date": "2026-09-15",
  "env": {
    "development": {
      "name": "inbot-site-dev",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./site",
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
      },
    },
    "production": {
      "name": "inbot-site",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "inbot.kerd.dev", "custom_domain": true }],
      "assets": {
        "directory": "./site",
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
      },
    },
  },
}
