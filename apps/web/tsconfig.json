{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": ".",
    "paths": {}
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
